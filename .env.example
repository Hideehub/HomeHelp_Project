# Copy to .env for local development. In production set these in your host's dashboard.
# Never commit real values.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:password@localhost:3306/dbname

# Paystack: use sk_test_... until you're ready to take real payments
PAYSTACK_SECRET_KEY=sk_test_xxx

# Email (Gmail: smtp.gmail.com, port 465, SSL, with an App Password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=app-password
MAIL_DEFAULT_SENDER=you@example.com

# Production only
# Number of proxies in front of the app (1 on Render/Railway/behind Nginx)
PROXY_COUNT=0
# True when served over HTTPS
SESSION_COOKIE_SECURE=False
# Optional: where uploads are saved (defaults to homehelp/static/images/uploads)
# UPLOAD_FOLDER=




















